# ── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/codereality?retryWrites=true&w=majority

# ── Admin Auth ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace_with_a_long_random_hex_string
ADMIN_PASSWORD=your_admin_password_here

# ── Gmail Email ───────────────────────────────────────────────────
# The Gmail address emails are sent FROM
GMAIL_USER=coderealityacademy.tech@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate at: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Select app: Mail, Select device: Other → name it "Codereality" → copy the 16-char password
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Admin email to receive new registration notifications
ADMIN_EMAIL=coderealityacademy.tech@gmail.com

# ── WhatsApp ──────────────────────────────────────────────────────
# Your WhatsApp business number in international format WITHOUT + sign
# e.g. 2348012345678 for a Nigerian number +234 801 234 5678
WHATSAPP_NUMBER=2348000000000
# Also expose it to the browser for the success page WhatsApp button:
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# ── Bank Payment Details (shown in confirmation email) ─────────────
BANK_NAME=Your Bank Name
ACCOUNT_NAME=Codereality Academy
ACCOUNT_NUMBER=0123456789
